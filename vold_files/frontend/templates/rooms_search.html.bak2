{% extends "base.html" %}
{% block title %}Wyszukiwanie sal{% endblock %}
{% block content %}
<h2 class="text-xl font-semibold mb-4">Wyszukaj dostępne sale</h2>

<form method="post" class="grid md:grid-cols-6 gap-3 bg-white p-4 rounded-lg shadow mb-6">
  {% csrf_token %}
  <div class="md:col-span-2">
    <label class="block text-sm mb-1">Data</label>
    <input id="date" name="date" type="date" required class="w-full border rounded px-3 py-2">
  </div>
  <div>
    <label class="block text-sm mb-1">Start (HH:MM)</label>
    <input id="start_hhmm" name="start_hhmm" type="time" required class="w-full border rounded px-3 py-2">
  </div>
  <div>
    <label class="block text-sm mb-1">Koniec (HH:MM)</label>
    <input id="end_hhmm" name="end_hhmm" type="time" required class="w-full border rounded px-3 py-2">
  </div>
  <div>
    <label class="block text-sm mb-1">Budynek (ID)</label>
    <input id="building_id" name="building_id" type="number" class="w-full border rounded px-3 py-2" placeholder="opcjonalnie">
  </div>
  <div>
    <label class="block text-sm mb-1">Min. pojemność</label>
    <input id="min_capacity" name="min_capacity" type="number" class="w-full border rounded px-3 py-2" placeholder="opcjonalnie">
  </div>

  <!-- Sprzęty -->
  <div class="md:col-span-6">
    <div class="text-sm mb-1">Wyposażenie (opcjonalnie)</div>
    <label class="mr-4"><input type="checkbox" name="equipment_ids" value="1"> Projektor</label>
    <label class="mr-4"><input type="checkbox" name="equipment_ids" value="2"> Tablica multimedialna</label>
    <label class="mr-4"><input type="checkbox" name="equipment_ids" value="3"> Komputery</label>
    <label class="mr-4"><input type="checkbox" name="equipment_ids" value="4"> Głośniki</label>
    <label class="mr-4"><input type="checkbox" name="equipment_ids" value="5"> Tablica ścierna</label>
  </div>

  <div class="md:col-span-6">
    <button class="bg-emerald-600 text-white px-4 py-2 rounded hover:bg-emerald-700">Szukaj</button>
  </div>
</form>

{% if error %}
  <div class="text-red-600">{{ error }}</div>
{% endif %}

{% if results %}
  <div class="mb-2 text-sm text-slate-600">
    Wyniki: <b>{{ results.total }}</b>, łączna pojemność: <b>{{ results.total_capacity }}</b>
  </div>
  <div class="bg-white rounded-lg shadow overflow-x-auto">
    <table class="min-w-full">
      <thead class="bg-slate-100 text-sm">
        <tr>
          <th class="text-left px-4 py-2">Sala</th>
          <th class="text-left px-4 py-2">Budynek</th>
          <th class="text-left px-4 py-2">Piętro</th>
          <th class="text-left px-4 py-2">Pojemność</th>
          <th class="text-left px-4 py-2">Akcje</th>
        </tr>
      </thead>
      <tbody class="text-sm">
        {% for r in results.items %}
        <tr class="border-t">
          <td class="px-4 py-2">{{ r.room_number }}</td>
          <td class="px-4 py-2">{{ r.building_id }}</td>
          <td class="px-4 py-2">{{ r.floor }}</td>
          <td class="px-4 py-2">{{ r.capacity }}</td>
          <td class="px-4 py-2">
            <button type="button" class="bg-blue-600 text-white px-3 py-1 rounded text-xs hover:bg-blue-700"
                    onclick="goReserve('{{ r.id }}','{{ r.room_number }}')">
              Rezerwuj
            </button>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% endif %}

<script>
function goReserve(roomId, roomNumber) {
  const date = document.getElementById("date").value;
  const start = document.getElementById("start_hhmm").value;
  const end   = document.getElementById("end_hhmm").value;

  const qs = new URLSearchParams({
    room_id: roomId,
    room_number: roomNumber,
    date: date,
    start_hhmm: start,
    end_hhmm: end
  });

  window.location.href = `/reserve?${qs.toString()}`;
}
</script>
{% endblock %}

{% extends "base.html" %}
{% block title %}Wyposażenie sal{% endblock %}
{% block h1 %}Zarządzanie wyposażeniem sal{% endblock %}
{% block subtitle %}Dodawaj i edytuj sprzęt w poszczególnych salach{% endblock %}

{% block content %}
<div class="grid" style="grid-template-columns: 1fr 2fr; gap:20px">
  
  <!-- Lista sal -->
  <div class="card">
    <div class="card-header"><h3>Sale</h3></div>
    <div class="card-body">
      <ul id="rooms-list" class="rooms-list" style="list-style:none;padding:0;margin:0"></ul>
    </div>
  </div>
  
  <!-- Szczegóły sali -->
  <div class="card">
    <div class="card-header"><h3 id="room-title">Wybierz salę</h3></div>
    <div class="card-body">
      <table class="eq-table" style="width:100%;margin-bottom:14px">
        <thead><tr><th>Sprzęt</th><th>Ilość</th><th>Akcje</th></tr></thead>
        <tbody id="room-equipment-list"></tbody>
      </table>
      
      <div id="add-equipment-form" style="display:none">
        <h4>Dodaj sprzęt</h4>
        <select id="equipment-select" class="input"></select>
        <input id="equipment-qty" type="number" class="input" value="1" min="1" style="width:80px;margin-top:8px">
        <button id="btn-add-eq" class="btn" style="margin-top:8px">Dodaj do sali</button>
      </div>
    </div>
  </div>
  
</div>

<script>
const token = localStorage.getItem("access_token");
let currentRoomId = null;

// pobierz listę sal
async function loadRooms(){
  const r = await fetch(`${window.API_BASE}/rooms`, { headers:{Authorization:"Bearer "+token}});
  const data = await r.json();
  const list = document.getElementById("rooms-list");
  list.innerHTML='';
  data.forEach(room=>{
    const li=document.createElement("li");
    li.textContent=`Sala ${room.room_number} (Budynek ${room.building_id}, piętro ${room.floor})`;
    li.className="room-item";
    li.style.cursor="pointer";
    li.onclick=()=> selectRoom(room);
    list.appendChild(li);
  });
}

// wybór sali
async function selectRoom(room){
  currentRoomId=room.id;
  document.getElementById("room-title").textContent=`Sala ${room.room_number} – wyposażenie`;
  document.getElementById("add-equipment-form").style.display="block";
  loadRoomEquipment(room.id);
  loadAllEquipment();
}

// pobierz wyposażenie sali
async function loadRoomEquipment(roomId){
  const r = await fetch(`${window.API_BASE}/room-equipment/rooms/${roomId}`, {method: "GET", headers:{Authorization:"Bearer "+token}});
  const data = await r.json();
  const list=document.getElementById("room-equipment-list");
  list.innerHTML='';
  data.forEach(item=>{
    const tr=document.createElement("tr");
    tr.innerHTML=`<td>${item.name}</td><td>${item.quantity}</td>
      <td><button class="btn btn-small">Edytuj</button></td>`;
    tr.querySelector("button").onclick=()=> editQuantity(item);
    list.appendChild(tr);
  });
}

// pobierz listę dostępnych sprzętów
async function loadAllEquipment(){
  const r = await fetch(`${window.API_BASE}/equipment/`, { headers:{Authorization:"Bearer "+token}});
  const data = await r.json();
  const sel=document.getElementById("equipment-select");
  sel.innerHTML=data.map(eq=>`<option value="${eq.id}">${eq.name}</option>`).join('');
}

// dodaj sprzęt do sali
document.getElementById("btn-add-eq").onclick=async()=>{
  const eqId=parseInt(document.getElementById("equipment-select").value);
  const qty=parseInt(document.getElementById("equipment-qty").value);
  const eqName=document.getElementById("equipment-select") 
                    .selectedOptions[0].textContent;

  const r=await fetch(`${window.API_BASE}/room-equipment/rooms/${currentRoomId}`,{
    method:"POST",
    headers:{Authorization:"Bearer "+token,"Content-Type":"application/json"},
    body:JSON.stringify({
      equipment_id: eqId,
      name: eqName, 
      quantity: qty
    })
  });
  if(r.ok){
    await loadRoomEquipment(currentRoomId);
  }else{
    const err=await r.json().catch(()=>({}));
    alert("Błąd dodawania: "+(err.detail||r.status));
  }
};


// edycja ilości sprzętu
async function editQuantity(item){
  const eqId=parseInt(document.getElementById("equipment-select").value);
  const eqName=document.getElementById("equipment-select")
  const newQty=prompt("Nowa ilość:",item.quantity);
  if(!newQty) return;
  const r=await fetch(`${window.API_BASE}/room-equipment/${item.id}`,{
    method:"PATCH",
    headers:{Authorization:"Bearer "+token,"Content-Type":"application/json"},
    body:JSON.stringify({equipment_id: eqId,name: eqName,quantity:parseInt(newQty)})
  });
  if(r.ok) loadRoomEquipment(currentRoomId);
  else alert("Błąd edycji ilości");
}

loadRooms();
</script>
{% endblock %}
